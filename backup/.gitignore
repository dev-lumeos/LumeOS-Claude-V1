# Datendumps nicht versionieren - zu gross, wachsen mit jedem Lauf.
# Schema-Sicherungen sind nach der Abnahme Geschichte -
# siehe docs/lehren/werkzeuge.md.
data/*
!data/.gitkeep

# Wegwerfgut aus Auftraegen - entsteht bei jeder Messung neu,
# wurde nie versioniert. Ignorieren nimmt nichts weg.
# Die Abnahmen zitieren die ZAHLEN, nicht die Dateien.
x-*
_g*.mjs
_c*.mjs
# Aeltere Messwerkzeuge lagen ohne fuehrenden Unterstrich direkt hier.
g*.mjs
c*.mjs

# Taegliche Laeufe und Protokolle - wachsen mit jedem Lauf.
_taeglich/
logs/

# Sicherungen vor dem Einspielen. Tom, 2026-09-08:
# "du nimmst ab und entscheidest ok, dann werden die backups
#  nicht mehr gebraucht und koennen in mein backuplaufwerk"
schema/*.sql
