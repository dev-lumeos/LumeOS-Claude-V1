{"satz":{"id":"2d1d53ac-cd18-b787-c899-563d1b400827","slug":"sub_77b68a4df6","texte":{"kurz_was":"Ein langwirksames Spritzen-Anabolikum, früher Medikament gegen Blutarmut und Knochenschwund, heute Graumarkt-Stoff.","wofuer":["Früher zugelassen bei Anämie und Osteoporose","Muskelaufbau im nichtmedizinischen Bereich","Im Sport verboten (WADA S1.1)"],"wie_wirkt":"Nandrolon ist Testosteron mit einem fehlenden Kohlenstoff-Atom – dadurch wirkt es stärker auf den Aufbau, schwächer auf die typisch männlichen Nebenwirkungen. Der Decanoat-Anhang funktioniert wie ein Zeitdepot: Das Hormon sickert über Tage bis Wochen aus dem Muskel ins Blut.","was_bringt_es":"Medizinisch war es gegen Blutarmut und Knochenschwund zugelassen, und seine aufbauende Wirkung ist physiologisch unstrittig. Für den sportlichen Einsatz existieren keine ordentlichen Studien; was belegt ist, sind die Kosten: Die eigene Testosteronproduktion wird abgeschaltet, die Blutfette verschlechtern sich, und das Depot macht den Stoff monatelang nachweisbar.","zu_viel":"Zu den dokumentierten Klassenrisiken zählen abgeschaltete Eigenproduktion, Libidoverlust und Erektionsstörungen trotz Kur (im Jargon als 'Deca Dick' bekannt, mit Prolaktin- und Gestagen-Aktivität erklärt), dazu Bluthochdruck und schlechte Blutfette. Der lange Ester bedeutet: Tritt ein Problem auf, dauert es Wochen, bis der Spiegel fällt.","zu_wenig":null,"wann_wie":"Das Depot-Prinzip prägt alles: Die Halbwertszeit liegt bei etwa einer Woche, der volle Abbau dauert deutlich länger, und Anti-Doping-Labore können Abbauprodukte bis zu anderthalb Jahre nachweisen. Der medizinische Einsatz war intramuskulär; eine nichtmedizinische Anwendung ist nirgends vorgesehen.","wer_nicht":["Wettkampfsportler (WADA S1.1, sehr lange Nachweisbarkeit)","Frauen (Virilisierungsrisiko, teils dauerhaft)","Jugendliche (vorzeitiger Schluss der Wachstumsfugen)","Männer mit Kinderwunsch (abgeschaltete Spermienproduktion)","Personen mit Herz-Kreislauf-Erkrankungen oder schlechten Blutfetten"],"mythen":"[{\"mythos_de\": \"Nandrolon heilt Gelenkschmerzen.\", \"korrektur_de\": \"Viele Anwender berichten weniger Gelenkschmerzen, vermutlich über Wassereinlagerung und Kollagenstoffwechsel. Eine Zulassung dafür gibt es nicht, und der Effekt deckt die Beschwerde nur zu – die Ursache bleibt, die Nebenwirkungen auch.\"}, {\"mythos_de\": \"Aus dem Blut heißt aus dem Körper.\", \"korrektur_de\": \"Der Decanoat-Ester hält den Stoff wochenlang im System, und Abbauprodukte sind bis zu etwa 18 Monate im Dopingtest sichtbar. Nandrolon gehört zu den am längsten nachweisbaren Anabolika überhaupt.\"}]","irreversibel":"Die abgeschaltete Eigenproduktion erholt sich meist, kann aber Monate bis über ein Jahr brauchen. Bei Frauen können Stimmvertiefung und Haarwuchs dauerhaft bleiben; bei Jugendlichen ist ein vorzeitiger Wachstumsstopp endgültig.","ueberwachung":"In der Fachliteratur zu anabolen Steroiden werden als Kontrollpunkte genannt: Blutfette, Leberwerte, Blutdruck, Blutbild (Hämatokrit), Testosteron- und Östradiolspiegel sowie die Fruchtbarkeitsparameter. Bei 19-nor-Stoffen wie Nandrolone kommt Prolaktin dazu.","reinheit":"Pharmazeutisches Nandrolon decanoate ist weitgehend vom Markt verschwunden; der Umlauf läuft über Untergrundlabore. Untersuchungen solcher Produkte fanden regelmäßig abweichende Konzentrationen und falsche Stoffe.","nicht_im_blut":"Das Blutbild zeigt Hormon- und Fettwerte, aber nicht den Zustand von Herzklappe, Gefäßwand oder Psyche; und ein 'normaler' Testosteronwert nach Absetzen heißt nicht, dass die Spermienproduktion wieder läuft – das zeigt nur ein Spermiogramm.","rechtslage_klartext":"Nandrolon fällt in den USA unter die Controlled Substances, in Deutschland unter das Arzneimittel- und Anti-Doping-Gesetz; Besitz in nicht geringer Menge ohne Rezept ist strafbar. Die WADA führt es unter S1.1 – ein Verstoß gilt als schweres Doping."},"fragen":[{"frage":"Warum ist Deca so lange im Dopingtest sichtbar?","antwort":"Der lange Ester baut sich über Wochen ab, und die charakteristischen Abbauprodukte lagern sich in Fett und Haaren ein. Die Anti-Doping-Literatur nennt Nachweiszeiträume bis zu etwa 18 Monaten – einer der längsten unter allen Anabolika."},{"frage":"Hilft Nandrolon wirklich bei Gelenkschmerzen?","antwort":"Die Besserung ist ein verbreiteter Erfahrungsbericht, plausibel erklärt über mehr Flüssigkeit in den Gelenken und Kollageneffekte. Als Medikament dafür zugelassen ist es nicht; es überdeckt die Beschwerde, ohne die Ursache zu beheben."},{"frage":"Was steckt hinter dem Begriff 'Deca Dick'?","antwort":"Gemeint sind Libidoverlust und Erektionsprobleme trotz hoher anaboler Hormonspiegel. Erklärt wird das mit der Gestagen- und Prolaktin-Aktivität des Stoffes plus abgeschalteter eigener Testosteronproduktion – ein in Foren und Fachliteratur gleichermaßen beschriebenes Muster."},{"frage":"Ist Nandrolon noch als Medikament erhältlich?","antwort":"In den meisten Ländern ist es vom regulären Markt verschwunden; die früheren Zulassungen (Blutarmut, Knochenschwund) wurden ruhend gestellt oder zurückgezogen. Praktisch der gesamte Umlauf stammt aus Untergrundlaboren."}],"quellen":[],"wada_kategorie":"S1.1","laborwirkungen":[],"wechselwirkungen":[],"community":null,"formen":[],"canonical_name":"Nandrolone decanoate","domain":"kimi_performance","compound_type":null,"category":"injizierbare_aas","subcategory":null,"chemical_form":null,"aliases":["deca-durabolin","deca-durabolin","deca-durabolin","nandrolone decanoate","Nandrolone decanoate","sub_77b68a4df6"],"cas_number":null,"external_ids":{"UNII":"H45187T098","molecular_formula":"C28H44O3","PubChem_CID":"9677","InChIKey":"JKWKMORAXJQQSR-MOPIKTETSA-N","ChEMBL_ID":"CHEMBL1200946"},"evidence":{"summary_en":"Experimental/grey-market compound; limited formal evidence.","animal_only":false,"human_trials":0,"in_vitro_only":false,"meta_analyses":0,"overall_grade":"D","randomized_trials":0,"human_evidence_raw":{},"evidence_source_ids":[],"evidence_linked_files":[]},"dosing":{"sources":[{"url":"https://dailymed.nlm.nih.gov/dailymed/search.cfm?query=nandrolone","year":null,"title":"Nandrolone decanoate historical label","verified":false},{"url":"https://dailymed.nlm.nih.gov/dailymed/search.cfm?query=nandrolone","year":null,"title":"Nandrolone decanoate label (historical): 50-200 mg IM/week","verified":false}],"upper_limit":{"value":null,"source_ids":[],"missing_reason":"NOT_APPLICABLE: no regulatory UL concept for unapproved/pharmaceutical compounds","provenance_type":"REGULATORY_UL"},"guideline_dose":{"value":null,"source_ids":[],"missing_reason":"No validated clinical guideline dose (no position stand/clinical practice guideline with a specific supplemental dose)","provenance_type":"CLINICAL_GUIDELINE"},"provenance_note":"Jedes Feld traegt provenance_type (MANUFACTURER_LABEL/CLINICAL_GUIDELINE/TRIAL_EXPOSURE/REGULATORY_UL/OTHER). verified=false markiert Quellen ohne Live-Abruf in dieser Session (SWARM_A verification_note). Keine Community-Daten in wissenschaftlichen Feldern (Paragraph 56/74).","integration_note":"Additiver Enrichment-Layer (CRAWL_037); kanonische Entity-Files wurden nicht ueberschrieben. Aufloesung per entity_id.","official_label_dose":{"value":"Historical/US label (anemia of renal insufficiency): 50-100 mg IM weekly (women) to 100-200 mg/week (men); largely discontinued","source_ids":[{"url":"https://dailymed.nlm.nih.gov/dailymed/search.cfm?query=nandrolone","year":null,"title":"Nandrolone decanoate label (historical): 50-200 mg IM/week","verified":false}],"missing_reason":null,"provenance_type":"MANUFACTURER_LABEL"},"studied_dose_ranges":{"value":[{"max":200,"min":50,"units":"mg/week","duration":"weeks-months","population":"anemia/cachexia studies","route_form":"IM","source_ids":[{"url":"https://dailymed.nlm.nih.gov/dailymed/search.cfm?query=nandrolone","year":null,"title":"Nandrolone decanoate historical label","verified":false}],"provenance_type":"TRIAL_EXPOSURE","endpoint_context":"erythropoiesis/lean mass"}],"source_ids":[{"url":"https://dailymed.nlm.nih.gov/dailymed/search.cfm?query=nandrolone","year":null,"title":"Nandrolone decanoate historical label","verified":false}],"missing_reason":null,"provenance_type":"TRIAL_EXPOSURE"},"anecdotal_dose_ranges":[]},"pharmacology":{"route":"intramuscular"},"half_life":null,"half_life_status":"unbekannt","cyp":null,"canonical_category":"injizierbare_aas","canonical_compound_type":null,"canonical_routes":["intramuscular"],"description":"Nandrolone decanoate ist ein leistungs- oder hormonbezogener Wirkstoff; der Katalog beschreibt Fakten, keine Anwendung.","gruppe":"enhanced","safety":{"lactation_status":"unknown","pregnancy_status":"unknown","contraindications_en":[],"common_side_effects_en":[],"serious_side_effects_en":[]},"interactions":null,"regulatory":{"jurisdiction":"usa","legal_status":"unknown","approved_drug":false,"approved_supplement_ingredient":false},"quality":null,"warning_triggers":{"doctor_consult_flags":["WADA-prohibited; unapproved or context-restricted - any use warrants physician disclosure; athletes: anti-doping violation"],"no_ceiling_reason_en":"Unapproved/research compound - no safe ceiling established"},"evidence_provenance":{"cas_number":{"source_id":"src_pubchem_9677","evidence_class":"B","as_of":"2026-08-20"},"molecular_weight":{"source_id":"src_pubchem_9677","evidence_class":"B","as_of":"2026-08-20"},"external_ids.UNII":{"source_id":"src_gsrs_H45187T098","evidence_class":"A","as_of":"2026-08-20"},"interaction_traits":{"source_id":"substance_groups.json (curated)","evidence_class":"B","as_of":"2026-08-20"},"mechanism_of_action":{"source_id":"src_chembl_CHEMBL1200946","evidence_class":"B","as_of":"2026-08-20"},"external_ids.InChIKey":{"source_id":"src_pubchem_9677","evidence_class":"B","as_of":"2026-08-20"},"external_ids.ChEMBL_ID":{"source_id":"src_chembl_CHEMBL1200946","evidence_class":"B","as_of":"2026-08-20"},"regulatory.wada_status":{"source_id":"src_wada_prohibited_list_2026","evidence_class":"A","as_of":"2026-08-20"},"external_ids.PubChem_CID":{"source_id":"src_pubchem_9677","evidence_class":"B","as_of":"2026-08-20"},"pharmacology.primary_targets":{"source_id":"src_chembl_CHEMBL1200946","evidence_class":"B","as_of":"2026-08-20"},"external_ids.molecular_formula":{"source_id":"src_pubchem_9677","evidence_class":"B","as_of":"2026-08-20"},"catalog_source.f05_substance_candidate.alias_match_to_kimi":{"source_id":"supabase/_pipeline/daten/substanz-katalog.json#Nandrolone Decanoate","evidence_class":"exact_alias_unique","as_of":""},"catalog_source.kimi_performance.primary":{"source_id":"backup\\kimi-research\\Kimi_Agent\\supplement_performance_database\\data\\substances\\performance_compounds.jsonl#sub_77b68a4df6","evidence_class":"source_record","as_of":""}},"wada_status":"prohibited","prescription_required":null,"dose_ceiling_value":null,"dose_ceiling_unit":null,"last_verified":null,"unii":"H45187T098","chembl_id":null,"inchikey":"JKWKMORAXJQQSR-MOPIKTETSA-N"}}
