# --- Projekt-eigene Claude-Konfiguration ---
# .claude/ stand bis 2026-08-04 im Wayland-Block. Wirkungslos: 93 Dateien
# darunter waren laengst getrackt (agents/, rules/, skills/, hooks/,
# settings.json). Die Regel blockierte ausschliesslich NEUE Dateien und liess
# .claude/hooks/protect-paths.ps1 (B-04) still verschwinden. Jetzt gezielt
# nur das lokale Rauschen ignorieren.
.claude/settings.local.json
.claude/settings.local.json.bak-*
.claude/hooks/*.log
.claude/*.bak*

# --- Codex-Konfiguration (B-19, 2026-08-06) ---
# .codex/ stand bis 2026-08-06 pauschal im Wayland-Block. Wirkungslos fuer
# den Bestand: .codex/hooks.json war laengst getrackt (lean-ctx-Hooks,
# echte Projektkonfiguration) — der Commit brauchte deshalb ein -f. Die
# Regel blockierte ausschliesslich NEUE Dateien. Wie bei .claude/ jetzt
# gezielt nur das lokale Rauschen ignorieren, nicht das Verzeichnis.
.codex/*.log
.codex/settings.local.json

