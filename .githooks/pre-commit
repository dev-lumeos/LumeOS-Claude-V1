#!/bin/sh
# Pre-Commit-Gate (B-14, 2026-08-05): typecheck + test + build.
# Anlass: der /dashboard-Bruch (typedRoutes) lag vor, waehrend test und
# typecheck gruen waren — nur der Build deckt diese Fehlerklasse ab.
# Aktivierung: git config core.hooksPath .githooks
# Umgehung im Notfall: git commit --no-verify (bewusst, nicht still).

# --- Grossdateien (2026-08-14) ---
# Anlass: GitHub warnte beim Push ueber zwei Sicherungen mit 52,6 und
# 51,8 MB. Beide waren vollstaendige Datenabzuege, obwohl eine
# Schemasicherung gemeint war — dreimal passiert (Block 28, Block 29,
# und ein dritter Fall, der vor dem Commit auffiel).
# GitHub empfiehlt hoechstens 50 MB und sperrt bei 100. Eine Datei, die
# einmal in der Historie liegt, bleibt dort — deshalb hier und nicht
# spaeter. Siehe backup/README.md.
grenze=10485760   # 10 MB
zu_gross=$(git diff --cached --name-only --diff-filter=ACM | while read -r f; do
  [ -f "$f" ] || continue
  groesse=$(wc -c < "$f")
  [ "$groesse" -gt "$grenze" ] && echo "  $f  $((groesse / 1048576)) MB"
done)
if [ -n "$zu_gross" ]; then
  echo "[gate] ROT — Dateien ueber 10 MB im Commit:" >&2
  echo "$zu_gross" >&2
  echo "[gate] Sicherungen gehoeren als --schema-only nach backup/schema/," >&2
  echo "[gate] Datenabzuege komprimiert (-Fc) nach backup/data/." >&2
  echo "[gate] Wenn die Datei wirklich so gross sein muss: --no-verify." >&2
  exit 1
fi

# --- Der Pruefumfang haengt am Staging (A-84, 2026-10-01) ---
#
# ANLASS, gemessen am 2026-10-01: die 27 Waechter brauchen 43 s, davon
# 15,6 s `encoding-pruefen` ueber 21.692 Dateien und 13 s die drei
# Pruefungen fuer Supplemente und SVG-Pfade. Ein Commit, der drei
# Markdown-Dateien traegt, fuhr das vollstaendig mit.
#
# Tom, 2026-10-01: "ein simpler commit solange braucht".
#
# ENTSCHEIDUNG: Traegt der Commit NUR Dateien unter `docs/`, laeuft
# `pnpm gate:docs` — die dokumentnahen Waechter plus `encoding-pruefen
# --staged`. Sobald eine Datei ausserhalb `docs/` dabei ist, laeuft
# `pnpm gate` unveraendert, mit allem.
#
# WARUM DAS TRAEGT: Markdown bricht keinen Typecheck und keinen Build.
# Was eine Punktdatei kaputt machen kann — ein toter Verweis, eine
# falsche Nummer, ein Zyklusbruch, eine kaputte Kodierung — pruefen die
# Waechter in `gate:docs`, und die Gegenprobe dazu ist belegt:
# eine doppelt kodierte Datei im Staging macht `--staged` rot.
#
# WAS ES NICHT TUT: es verzichtet auf keinen Waechter fuer Code. Ein
# Commit mit einer Zeile in `apps/` oder `supabase/` wird genauso
# geprueft wie vorher.
gestaged=$(git diff --cached --name-only)
ausserhalb_docs=$(printf '%s\n' "$gestaged" | grep -v '^docs/' | grep -v '^[[:space:]]*$')

if [ -z "$gestaged" ]; then
  echo "[gate] nichts im Staging — voller Lauf."
  pnpm gate
elif [ -z "$ausserhalb_docs" ]; then
  anzahl=$(printf '%s\n' "$gestaged" | grep -c '^docs/')
  echo "[gate] nur docs/ im Commit ($anzahl Dateien) — pnpm gate:docs ..."
  pnpm gate:docs
else
  echo "[gate] pnpm gate (typecheck + test + build) ..."
  pnpm gate
fi
status=$?
if [ $status -ne 0 ]; then
  echo "[gate] ROT — Commit abgebrochen (Umgehung: --no-verify)." >&2
  exit $status
fi
echo "[gate] gruen."
exit 0
