  "mindestzeilen_belege": {
    "_kommentar": "Herkunft je Untergrenze. Gerundete Werte sind absichtlich als gerundet markiert; sie sind Warnschwellen, keine exakten Sollwerte.",
    "foods": "[read] docs/ssot/30-datenbank.md, Tabelle Stand lokale Datenbank: 7.140.",
    "food_nutrients": "[cmd] 031_fettsaeuren_nachtrag.sql + v031_fettsaeuren.sql: 698.092 aus 030 plus 171.409 Nachtrag = 869.501.",
    "food_aliases": "[cmd] Ist-Stand nach 022/026/028: editorial 21.420, derived 11.102, curated_nebenname 283, curated_suchbegriff 12. Summe: 32.817.",
    "food_tags": "[cmd] 020_food_human_layer.sql erzeugt 9.265 Makro-Tags; 027_lebensmittel-tags.ts ergaenzt 8.702 kuratierte C-44-Tags (Summe 17.967). C-93 ergaenzt 032-halal-koscher-tags.sql: halal 6.379 und kosher 6.451 aus den Ausschluss-Presets abgeleitet. Summe nach Lauf: 30.797.",
    "nutrient_defs": "[read] 015_nutrient_defs_seed.sql und BLS-Katalog: 138.",
    "nutrient_reference_values": "[read] C-45: Tom 2026-08-15 verlangt eine Antwort fuer alle 138 Naehrstoffcodes. Schritt 016 bricht ab, wenn nicht jeder Code mindestens eine Referenzwert- oder NO_REFERENCE-Zeile hat.",
    "food_categories": "[cmd] Gerundeter Ist-Stand nach 020: 518, Untergrenze 500.",
    "search_synonyms": "[cmd] Gerundeter Ist-Stand nach 024: 4.877, Untergrenze 4.800.",
    "preparation_kinds": "[read] 023_zubereitung_ableitung.sql: 11 Zubereitungsarten.",
    "food_groups": "[read] 023_zubereitung_ableitung.sql: 19 Warengruppen.",
    "foods_portions": "029_portionen-einspielen.ts, gemessen 2026-08-15: 23.402 Zeilen ueber 7.048 Lebensmittel. Gerundet, weil die Zahl mit jeder Kategoriezuordnung wandert.",
    "micronutrient_overview_items": "[read] supabase/_pipeline/daten/mikro-uebersicht.json: exakt 8 kuratierte Eintraege fuer die Vorlage."
  },
  "mindestzeilen_schema_belege": {
    "training.exercises": "[cmd] Ist-Stand nach 100-105: 1.416 Uebungen.",
    "training.muscle_groups": "[cmd] Ist-Stand nach 100-108: 95 Muskelgruppen nach 11 kollisionsfreien Alias-/Dubletten-Merges und Entfernen von Achilles Tendon als Sehne.",
    "training.equipment": "[cmd] Ist-Stand nach 100-105: 58 Geraete.",
    "training.exercise_muscles": "[cmd] Ist-Stand nach 100-108: 6.588 Zuordnungen. 6.624 nach C-73 minus 35 Primary/Secondary-Doppelrollen und minus 1 Achilles-Tendon-Sehnenzuordnung.",
    "training.exercise_catalog_enrichment": "[cmd] C-83: 1.416 Training-Uebungen gegen media/exercises/katalog/1500+ exercise data.xlsx gematcht; 1.407 sicher anreicherbar, 8 mehrdeutig, 1 fehlend.",
    "supplements.supplement_catalog": "[cmd] referenz/lumeos-2026/supabase/seed.disabled/seed_supplements.sql enthaelt 44 Standard-Supplements; 131_supplements_katalog.ts spielt diese 44 ein.",
    "medical.biomarker_catalog": "[cmd] C-70b: biomarker-loinc/index.json fuehrt 11.676 LOINC-Records in acht Split-Dateien; 141_biomarker_katalog.ts bricht bei abweichender Summe ab.",
    "medical.biomarker_reference_ranges": "[cmd] C-70: biomarker-katalog.json fuehrt 122 kuratierte Kandidaten mit 464 Referenzbereich-Zeilen. C-84 ergaenzt 96 Spec-basierte Bereichszeilen aus docs/specs/Medical/SPEC_05_BIOMARKER_CATALOG.md; Summe 560.",
    "medical.biomarker_spec_enrichment": "[cmd] C-84: SPEC_05_BIOMARKER_CATALOG.md enthaelt 47 extrahierbare Marker; 44 LOINC-Codes liegen im 11.676er Katalog und werden als Spec-Anreicherung neben dem LOINC-Katalog gespeichert.",
    "medical.biomarker_aliases": "[cmd] C-72: daten/biomarker-aliases.json fuehrt 304 eindeutige importierbare Legacy-Aliaszeilen plus 6 kuratierte Mehrdeutigkeitszeilen; 143 importiert zusammen 310. Die 18 Thai-Aliase bleiben offen, weil die aktuelle Faltung sie nicht traegt."
