[Unit]
Description=Spark C / DGX3 - Nemotron reviewer candidate (LUMEOS)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/admin
ExecStart=/home/admin/start-spark-c.sh
ExecStop=/usr/bin/docker stop vllm_node
Restart=always
RestartSec=10
TimeoutStartSec=600
TimeoutStopSec=60
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
