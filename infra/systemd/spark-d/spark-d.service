[Unit]
Description=ARCHIVED Spark D / DGX4 GPT-OSS service - do not use
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/admin
ExecStart=/home/admin/start-spark-d.sh
Restart=no
TimeoutStartSec=60
TimeoutStopSec=60
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
