{
    "hooks":  {
                  "PreToolUse":  [
                                     {
                                         "matcher":  "Write|Edit|Read",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "powershell -NoProfile -ExecutionPolicy Bypass -File \"D:/GitHub/LumeOS-Claude-V1/.claude/hooks/protect-paths.ps1\""
                                                       }
                                                   ]
                                     },
                                     {
                                         "matcher":  "Bash",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "powershell -NoProfile -ExecutionPolicy Bypass -File \"D:/GitHub/LumeOS-Claude-V1/.claude/hooks/protect-paths.ps1\""
                                                       }
                                                   ]
                                     }
                                 ]
              },
    "permissions":  {
                        "deny":  [
                                     "Bash(git push:*)",
                                     "Bash(git reset --hard:*)",
                                     "Bash(git clean:*)",
                                     "Bash(supabase db reset:*)",
                                     "Bash(supabase db push:*)",
                                     "Bash(npx supabase db reset:*)",
                                     "Bash(npx supabase db push:*)",
                                     "Bash(rm:*)",
                                     "Bash(sudo:*)",
                                     "Bash(chmod:*)",
                                     "Read(./.env)",
